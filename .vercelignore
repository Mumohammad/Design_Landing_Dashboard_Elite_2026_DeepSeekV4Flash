# Local credentials, database backups, and verification artifacts must never upload.
.env*
.vercel/
.git/
supabase/.temp/
supabase/.branches/
.kilo/
node_modules/
.next/
out/
build/
coverage/
test-results/
playwright-report/
blob-report/
.playwright/
screenshots/
loadtest/results/
*.pem
*.tsbuildinfo
*-debug.log*
Design_Landing_Dashboard_Elite_2026_DeepSeekV4Flash/

# Local PDF comparisons and private release reviews are never deployment inputs.
output/
tmp/pdfs/

# Only these two operator-licensed font assets may enter the PDF function.
private/*
!private/invoice-fonts
private/invoice-fonts/*
!private/invoice-fonts/regular.ttf
!private/invoice-fonts/bold.ttf

# Stale local investigation artifacts are never runtime inputs.
*.log
/dashboard-page-local-backup.patch
/p0-1-production-supabase/p0-1-production-supabase.patch
/deployment_info.txt
/lint-errors.txt
/lint-report.txt
