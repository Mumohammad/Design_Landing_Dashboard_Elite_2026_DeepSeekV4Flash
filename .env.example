# ═══════════════════════════════════════════════════════════════
# EliteDev Saudi 3PL Platform — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or populated secrets.
# The service-role key must NEVER be exposed to the browser.

# ── Application ───────────────────────────────────────────────
# The public URL of the deployed app (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (Client / Public) ─────────────────────────────────
# From: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# From: Supabase Dashboard → Project Settings → API → anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (Server / Service Role) ────────────────────────────
# SERVER-ONLY. Bypasses RLS. Never import in client components.
# From: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (Email) ─────────────────────────────────────────────
# Used for invite emails, password reset, notifications.
# From: https://resend.com/api-keys
RESEND_API_KEY=

# The "from" address for outgoing emails. Must be a verified domain in Resend.
RESEND_FROM_EMAIL=

# ── Sentry (Error Tracking) ────────────────────────────────────
# Optional. DSN from Sentry project settings.
SENTRY_DSN=

# Optional. Public DSN for client-side Sentry (same value as SENTRY_DSN).
NEXT_PUBLIC_SENTRY_DSN=

# ── Logging ────────────────────────────────────────────────────
# Log level: debug, info, warn, error. Default: debug (dev) / info (prod).
LOG_LEVEL=

# Threshold (ms) for slow-operation warnings. Default: 1000.
PERF_LOG_THRESHOLD_MS=

# ── Upstash Redis (Rate Limiting — Phase 2, optional) ─────────
# Optional. Used for rate limiting (sign-in, forgot-password, etc.).
# If not set, in-memory rate limiting is used (development only).
# From: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── E2E Testing (Playwright) ────────────────────────────────────
# Credentials for the test user. Must have full permissions.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Base URL for E2E tests (defaults to http://localhost:3000).
# Set to staging URL for CI tests against a deployed preview.
BASE_URL=

# ── Cron / Background Jobs ──────────────────────────────────────
# Secret for Vercel Cron endpoints (e.g., webhook retry processing).
CRON_SECRET=

# ── Webhook Secrets (Incoming) ──────────────────────────────────
# Shared secrets for verifying incoming webhooks from external services.
# Format: {PLATFORM}_WEBHOOK_SECRET
# Examples:
ZATCA_WEBHOOK_SECRET=
CAREEM_WEBHOOK_SECRET=
UBER_WEBHOOK_SECRET=
MOYASAR_WEBHOOK_SECRET=
TAP_WEBHOOK_SECRET=
