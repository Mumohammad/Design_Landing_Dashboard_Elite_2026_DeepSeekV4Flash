{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "framework":  "nextjs",
    "buildCommand":  "pnpm build",
    "installCommand":  "pnpm install --frozen-lockfile",
    "outputDirectory":  ".next",
    "regions":  [
                    "iad1"
                ],
    "headers":  [
                    {
                        "source":  "/api/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-store, max-age=0"
                                        }
                                    ]
                    },
                    {
                        "source":  "/_next/static/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=31536000, immutable"
                                        }
                                    ]
                    }
                ]
}